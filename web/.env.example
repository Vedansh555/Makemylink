# Copy to .env.local and fill in. Never commit real values.
# Local development works with NONE of these: it uses an embedded Postgres in web/data/pglite.

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Support email shown on the legal pages (defaults to the founder email)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Public site URL (sitemap, canonical links, emails)
NEXT_PUBLIC_SITE_URL=https://makemylink.co

# Hosted Postgres (Neon). Leave empty locally. Required in production.
DATABASE_URL=

# Email (Resend). Without it, emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=Makemylink <hello@yourdomain.com>

# Payments for Pro. India uses Razorpay, everyone else Stripe.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks > event payment.captured > URL /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
# Stripe dashboard > Webhooks > event checkout.session.completed > URL /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Emails (comma separated) allowed to open /admin
ADMIN_EMAILS=

# Shared secret for the daily broken-link check (any long random string)
CRON_SECRET=

# Photo storage (Cloudflare R2). Without these, photos stay inside the page data (works, but slower).
# R2_PUBLIC_URL is the bucket's public address (r2.dev URL or your own cdn domain). Add a CORS rule allowing PUT from your site.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
