# Copy to .env.local and fill in. Never commit real values.

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public site URL (used by sitemap and robots), once you have a domain
NEXT_PUBLIC_SITE_URL=https://makemylink75.vercel.app

# Hosted Postgres (Neon). Needed once the database is migrated from SQLite.
DATABASE_URL=

# Email (Resend)
RESEND_API_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Photo storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Rate limiting across servers (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
